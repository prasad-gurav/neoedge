NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/neoedge

# Comma-separated list of allowed frontend origins (leave empty to use sensible localhost defaults)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Neoedge <noreply@neoedge.local>
